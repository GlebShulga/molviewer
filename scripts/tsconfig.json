{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // build-og-art.ts reuses the app's parsers, whose imports reach React and Vite code.
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "../src/vite-env.d.ts"]
}
